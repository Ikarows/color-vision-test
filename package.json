{
  "name": "color-vision-test",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/protect-assets.mjs",
    "preview": "vite preview",
    "app:build": "vite build && node scripts/protect-assets.mjs && electron-builder --publish never"
  },
  "build": {
    "appId": "com.local.colorvisiontest",
    "productName": "色盲色弱助手",
    "electronVersion": "26.2.0",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName} v${version}.${ext}",
    "afterPack": "scripts/afterPack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "executableName": "ColorVisionHelper",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^5.7.8",
    "@capacitor/app": "^5.0.8",
    "@capacitor/cli": "^5.7.8",
    "@capacitor/core": "^5.7.8",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright-core": "^1.64.1",
    "postcss-pxtorem": "^6.1.0",
    "sass-embedded": "^1.105.1",
    "sharp": "^0.35.5",
    "vite": "^6.0.7"
  },
  "description": "<div align=\"center\">\r <p><img width=\"150\" src=\"./public/logo.png\"></p>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ikarows/color-vision-test.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ikarows/color-vision-test/issues"
  },
  "homepage": "https://github.com/Ikarows/color-vision-test#readme"
}
